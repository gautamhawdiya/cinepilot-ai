# Copy this file to .env and fill in real values. Never commit .env.

# --- Gemini / Google ADK ---
# Local development (AI Studio key, simplest path):
GOOGLE_API_KEY=

# Cloud deployment (Vertex AI via ADK, no API key needed if the Cloud Run
# service account has the Vertex AI User role — leave GOOGLE_API_KEY unset
# and set these instead):
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_ENTERPRISE=True

# --- Parallel (production research partner) ---
PARALLEL_API_KEY=

# --- Storyboard preview images ---
# Set to false to skip real image generation entirely (e.g. on a publicly
# reachable deployment, to avoid unmetered visitors burning Vertex quota).
# Defaults to true.
# ENABLE_STORYBOARD_IMAGES=false

# --- API server ---
# Comma-separated list of origins allowed to call this API. Defaults to
# localhost:5173 (Vite dev server) when unset. Set this to your deployed
# frontend origin(s) in production, e.g.:
# CORS_ALLOWED_ORIGINS=https://cinepilot-frontend-xxxxx.a.run.app
CORS_ALLOWED_ORIGINS=
